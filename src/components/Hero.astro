---
const trustItems = [
  {
    icon: 'map-pin',
    label: 'Lokalizacja',
    title: 'Lubin',
    detail: 'ul. Pawia 67 · sprawdź trasę na mapie',
  },
  {
    icon: 'scan-line',
    label: 'Technologia',
    title: 'Skan 3D Shining',
    detail: 'Cyfrowe odwzorowanie zębów na miejscu',
  },
  {
    icon: 'calendar-clock',
    label: 'Zapisy',
    title: 'Rejestracja',
    detail: 'Pon–Pt 9:00–18:00 · zapytaj o dostępny termin',
  },
];
---

<section
  id="home"
  class="hero-bg relative flex min-h-[85vh] flex-col overflow-hidden md:min-h-[90vh]"
>
  <div
    class="container relative z-10 mx-auto flex flex-1 flex-col justify-center px-6 pb-10 pt-28 sm:px-8 sm:pb-12 sm:pt-32 md:px-6 md:pb-14 md:pt-36 lg:py-40"
  >
    <div class="max-w-4xl py-6 sm:py-10 md:py-14 lg:py-16">
      <p
        class="hero-on-image mb-5 text-[10px] font-bold uppercase tracking-[0.35em] text-white/95 md:mb-6 md:text-xs md:tracking-[0.4em]"
      >
        ortodoncja · stomatologia dziecięca · Lubin
      </p>
      <h1
        class="hero-on-image serif mb-6 max-w-[18ch] text-[2.125rem] font-normal leading-[1.05] tracking-tight text-white sm:mb-7 sm:max-w-[20ch] sm:text-5xl md:mb-8 md:text-[3.25rem] lg:text-[3.75rem] lg:leading-[1.04]"
      >
        Ortodonta w&nbsp;Lubinie dla dzieci, młodzieży i&nbsp;dorosłych
      </h1>
      <p class="hero-on-image mb-10 max-w-xl text-base font-light leading-snug text-white/92 md:mb-12 md:text-lg md:leading-snug">
        Konsultacja, diagnostyka i leczenie wad zgryzu w jednym gabinecie. Pomagamy też zadbać o zdrowie zębów dziecka przed rozpoczęciem ortodoncji.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#kontakt"
          class="btn-gold hero-on-image group inline-flex items-center justify-center gap-2 rounded-lg px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] shadow-xl md:px-10 md:py-[1.125rem] md:text-sm md:tracking-[0.2em]"
        >
          Umów konsultację
          <i data-lucide="calendar" class="h-4 w-4 transition-transform group-hover:scale-110"></i>
        </a>
        <a
          href="tel:+48694731124"
          class="hero-on-image inline-flex items-center justify-center gap-2 rounded-lg border border-white/55 bg-white/10 px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white backdrop-blur-sm transition-colors hover:bg-white hover:text-navy md:px-10 md:py-[1.125rem] md:text-sm"
        >
          Zadzwoń i zapytaj o termin
          <i data-lucide="phone" class="h-4 w-4"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-trust-bar relative z-10 mt-auto w-full shrink-0">
    <div class="container mx-auto px-6 py-6 sm:px-8 md:py-8">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4 md:gap-8">
        {
          trustItems.map((item, index) => (
            <div
              class:list={[
                'flex min-w-0 gap-3 sm:gap-4',
                index > 0 && 'sm:border-l sm:border-white/20 sm:pl-6 md:pl-8',
              ]}
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-gold"
                aria-hidden="true"
              >
                <i data-lucide={item.icon} class="h-[1.125rem] w-[1.125rem]"></i>
              </span>
              <div class="min-w-0">
                <p class="hero-on-image mb-0.5 text-[10px] font-bold uppercase tracking-[0.2em] text-white/75">
                  {item.label}
                </p>
                <p class="hero-on-image text-lg font-bold leading-tight text-white md:text-xl">{item.title}</p>
                <p class="hero-on-image mt-1 text-[13px] leading-snug text-white/85 md:text-sm">{item.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
