---
import { HERO_IMAGE, HERO_SRCSET, HERO_SIZES } from '../data/images';
const trustItems = [
  {
    icon: 'check-circle',
    title: 'Specjalista ortodonta',
    detail: 'dr n. med. Kornelia Rumin',
  },
  {
    icon: 'scan-line',
    title: 'Skan 3D i RTG na miejscu',
    detail: 'Diagnostyka w jednym gabinecie',
  },
  {
    icon: 'calendar-clock',
    title: 'Konsultacja z diagnostyką od 400 zł',
    detail: 'Pon.–pt. 9:00–18:00 · ul. Pawia 67',
  },
];
---

<section id="home" class="clinic-hero" aria-labelledby="hero-heading">
  <div class="container hero-container mx-auto px-6 sm:px-8">
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="hero-eyebrow">Dzieci · młodzież · dorośli · skan 3D i RTG na miejscu</p>
        <h1 id="hero-heading" class="serif"><span class="hero-heading-location">Ortodonta w Lubinie:</span> <span class="hero-heading-treatment">aparaty i leczenie wad zgryzu</span></h1>
        <p class="hero-lead">
          Konsultacje prowadzi <a href="/dr-kornelia-rumin">dr n. med. Kornelia Rumin</a>, specjalista ortodonta. Diagnostyka na miejscu, ul. Pawia 67.
        </p>
        <div class="hero-actions">
          <a href="#kontakt" class="hero-cta hero-cta-primary">
            <i data-lucide="calendar" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
            <span>Umów konsultację ortodontyczną</span>
          </a>
          <a href="tel:+48694731124" class="hero-cta hero-cta-secondary">
            <i data-lucide="phone" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
            <span>Zadzwoń: +48 694 731 124</span>
          </a>
        </div>
        <nav class="hero-services" aria-label="Zakres leczenia">
          <a href="/zabiegi/ortodoncja">aparaty i wady zgryzu</a>
          <a href="/zabiegi/ortodoncja-dziecieca">ortodoncja dziecięca</a>
          <a href="/zabiegi/stomatologia-i-ortodoncja-dziecieca">stomatologia dziecięca</a>
        </nav>
      </div>
      <div class="hero-photo">
        <!-- TODO: Podmienić tymczasowe zdjęcie konsultacji na dostarczony plik pod tą samą ścieżką; zachować proporcje 4:3 i rozmiar poniżej 200 KB. -->
        <img
          src={HERO_IMAGE}
          srcset={HERO_SRCSET}
          sizes={HERO_SIZES}
          alt="Konsultacja ortodontyczna dziecka w gabinecie ORTHOMEDICA w Lubinie"
          width="1200"
          height="900"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
  </div>
  <div class="hero-trust-bar">
    <div class="container hero-trust-container mx-auto px-6 py-6 sm:px-8 md:py-7">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4 md:gap-8">
        {trustItems.map((item, index) => (
          <div class:list={[
            'flex min-w-0 gap-3 sm:gap-4',
            index > 0 && 'sm:border-l sm:border-navy/15 sm:pl-6 md:pl-8',
          ]}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-navy/15 bg-white/65 text-gold" aria-hidden="true">
              <i data-lucide={item.icon} class="h-[1.125rem] w-[1.125rem]"></i>
            </span>
            <div class="min-w-0">
              <p class="hero-trust-title">{item.title}</p>
              <p class="hero-trust-detail mt-1">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
