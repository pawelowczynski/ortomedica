---
import Layout from '../layouts/layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Cennik from '../components/Cennik.astro';
import Hero from '../components/Hero.astro';
import OfferGrid from '../components/OfferGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Team from '../components/Team.astro';
import LocalSEO from '../components/LocalSEO.astro';
import FAQSection from '../components/FAQSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { canonicalUrl, homepageGraphJsonLd } from '../data/schema';
import { homePageFaqs } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homePageFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout 
    title="Ortodonta Lubin i stomatologia dziecięca | ORTHOMEDICA"
    description="ORTHOMEDICA Lubin: ortodoncja dzieci i dorosłych, stomatologia dziecięca, RTG i skan 3D na miejscu. Umów konsultację z dr n. med. Kornelią Rumin."
    canonical={canonicalUrl('/')}
    preloadImage="/images/orthomedica-hero-building.png"
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(homepageGraphJsonLd())} />

    <Header />
    
    <main id="main-content">
        <Hero />
        <OfferGrid />
        <ProcessSteps />
        <Team />
        <Cennik />

        <FAQSection />

        <ContactSection />
        <LocalSEO />
    </main>

    <Footer />
</Layout>
