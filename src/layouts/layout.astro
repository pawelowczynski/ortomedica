---
import '../styles/global.css';
import { DEFAULT_OG_IMAGE_URL, SITE_ORIGIN } from '../data/site';
import { serviceGraphJsonLd } from '../data/schema';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
/** GA4 / Meta — ladowane dopiero po zgodzie na cookies (main.js), nie tutaj */

const {
  title,
  description,
  canonical = `${SITE_ORIGIN}/`,
  image = DEFAULT_OG_IMAGE_URL,
  robots,
  ogType = 'website',
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

// Vercel hosts staging builds; production keeps the canonical domain indexable.
const isStaging =
  process.env.VERCEL === '1' ||
  (process.env.VERCEL_URL ?? '').endsWith('.vercel.app') ||
  Astro.url.hostname.endsWith('.vercel.app');
const robotsDirective = isStaging ? 'noindex, nofollow' : robots;
const serviceSchema = new URL(canonical).pathname.startsWith('/zabiegi/')
  ? serviceGraphJsonLd(title.split(/\s[|—]\s/)[0], canonical, description)
  : null;

const ogImage = image.startsWith('http')
  ? image
  : `${SITE_ORIGIN}${image.startsWith('/') ? image : `/${image}`}`;
---
<!DOCTYPE html>
<html lang="pl" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {robotsDirective && <meta name="robots" content={robotsDirective} />}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="/site.webmanifest">
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="ORTHOMEDICA">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
    <slot name="head" />
    
</head>
<body class="antialiased pb-24 md:pb-0 relative">
    <slot />
    <AnalyticsConsent />
    <script src="../scripts/main.js"></script>
</body>
</html>
